// ── Redis-free infrastructure models ─────────────────────────────────────────

// Replaces Redis `revoked:{token}` blocklist for JWT revocation on logout/
// password change / MFA disable. A cron job purges expired rows nightly.
model RevokedToken {
  token     String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("revoked_tokens")
}

// Replaces Redis `approval:{uuid}` for manager approval tokens (120s TTL).
// A cron job or lazy-purge on access will clean up expired rows.
model ManagerApprovalToken {
  id          String   @id @default(uuid())
  action      String
  contextId   String
  channelId   String?
  approverId  String
  actorId     String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
  @@map("manager_approval_tokens")
}

// Replaces Redis `login_failures:{userId}` counter for brute-force protection.
// Counts consecutive failed attempts within a rolling 15-minute window.
model LoginAttempt {
  id        String   @id @default(uuid())
  userId    String
  failedAt  DateTime @default(now())

  @@index([userId, failedAt])
  @@map("login_attempts")
}
