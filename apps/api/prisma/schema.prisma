generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Enterprise {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  email        String?
  phone        String?
  logoUrl      String?
  plan         String     @default("STARTER")
  planFeatures Json       @default("{}")
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  channels     Channel[]
  users        User[]
  items        Item[]
  auditLogs    AuditLog[]
  invites      EnterpriseInvite[]

  @@map("enterprises")
}

model EnterpriseInvite {
  id           String      @id @default(uuid())
  code         String      @unique
  businessName String?
  plan         String      @default("STARTER")
  createdBy    String
  isUsed       Boolean     @default(false)
  usedAt       DateTime?
  enterpriseId String?
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
  enterprise   Enterprise? @relation(fields: [enterpriseId], references: [id])

  @@index([code])
  @@index([isUsed])
  @@map("enterprise_invites")
}

model Channel {
  id                  String               @id @default(uuid())
  enterpriseId        String?
  name                String
  code                String               @unique
  type                ChannelType
  isMainWarehouse     Boolean              @default(false)
  featureFlags        Json                 @default("{}")
  address             String?
  phone               String?
  email               String?
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  enterprise          Enterprise?          @relation(fields: [enterpriseId], references: [id])
  accounts            Account[]
  bankDeposits        BankDeposit[]
  expenses            Expense[]
  inventoryBalances   InventoryBalance[]
  journalEntries      JournalEntry[]
  notifications       Notification[]
  purchaseOrders      PurchaseOrder[]
  purchases           Purchase[]
  sales               Sale[]
  sessions            SalesSession[]
  serials             Serial[]
  stockMovements      StockMovement[]
  transfersFrom       Transfer[]           @relation("FromChannel")
  transfersTo         Transfer[]           @relation("ToChannel")
  users               User[]
  stockTakes          StockTake[]
  brands              Brand[]
  categories          Category[]
  suppliers           Supplier[]
  customers           Customer[]
  deductionRules      DeductionRule[]
  allowanceRules      AllowanceRule[]
  taxConfigs          TaxConnectorConfig[]
  documentTemplates   DocumentTemplate[]
  commissionRules     CommissionRule[]
  commissionEntries   CommissionEntry[]
  commissionPayouts   CommissionPayout[]
  salaryRuns          SalaryRun[]
  settings            Setting[]
  customerPayments    CustomerPayment[]
  loyaltyTransactions LoyaltyTransaction[]
  fixedAssets         FixedAsset[]
  userTargets         UserTarget[]
  serviceChecklists   ServiceChecklist[]
  banks               ChannelBank[]
  repairs             RepairRequest[]
  suspendedSales      SuspendedSale[]
  costAudits          CostAudit[]
  syncConflicts       SyncConflict[]
  invoices            Invoice[]
  jobLevels           JobLevel[]
  expenseCategories   ExpenseCategory[]
  kraPin              String?

  @@index([enterpriseId])
  @@map("channels")
}

model User {
  id               String    @id @default(uuid())
  enterpriseId     String?
  username         String    @unique
  email            String    @unique
  passwordHash     String
  role             UserRole
  mfaSecret        String?
  mfaEnabled       Boolean   @default(false)
  mfaRecoveryCodes String[]
  channelId        String?
  lastLoginAt      DateTime?

  // Google OAuth fields
  googleAccessToken    String?
  googleRefreshToken   String?
  googleTokenExpiresAt DateTime?
  googleEmail          String?

  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  status             UserStatus         @default(ACTIVE)
  enterprise         Enterprise?        @relation(fields: [enterpriseId], references: [id])
  approvedApprovals  ManagerApproval[]  @relation("ApprovedBy")
  requestedApprovals ManagerApproval[]  @relation("RequestedApprovals")
  sessions           SalesSession[]
  staffProfile       StaffProfile?
  supportTickets     SupportTicket[]
  channel            Channel?           @relation(fields: [channelId], references: [id])
  startedTakes       StockTake[]        @relation("StartedTakes")
  completedTakes     StockTake[]        @relation("CompletedTakes")
  commissionRules    CommissionRule[]
  commissionEntries  CommissionEntry[]
  commissionPayouts  CommissionPayout[]
  refreshTokens      RefreshToken[]
  assignedTickets    SupportTicket[]    @relation("AssignedTickets")
  sentTransfers      Transfer[]         @relation("SentTransfers")
  receivedTransfers  Transfer[]         @relation("ReceivedTransfers")
  targets            UserTarget[]
  repairsAssigned    RepairRequest[]    @relation("AssignedRepairs")
  resolvedConflicts  SyncConflict[]     @relation("ResolvedConflicts")
  invoicesCreated    Invoice[]

  @@index([enterpriseId])
  @@index([channelId])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  issuedAt  DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@map("refresh_tokens")
}

model Account {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  type        AccountType
  parentId    String?
  isSystem    Boolean      @default(false)
  channelId   String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  channel     Channel?     @relation(fields: [channelId], references: [id])
  parent      Account?     @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    Account[]    @relation("AccountHierarchy")
  ledgerLines LedgerLine[]

  @@map("accounts")
}

model JournalEntry {
  id            String         @id @default(uuid())
  description   String
  referenceId   String
  referenceType JournalRefType
  channelId     String
  postedAt      DateTime       @default(now())
  postedBy      String
  reversedAt    DateTime?
  channel       Channel        @relation(fields: [channelId], references: [id])

  lines LedgerLine[]

  @@index([referenceId])
  @@index([channelId, postedAt])
  @@map("journal_entries")
}

model LedgerLine {
  id             String       @id @default(uuid())
  journalEntryId String
  accountId      String
  debitAmount    Decimal      @default(0) @db.Decimal(14, 4)
  creditAmount   Decimal      @default(0) @db.Decimal(14, 4)
  memo           String?
  createdAt      DateTime     @default(now())
  account        Account      @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("ledger_lines")
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  channelId String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  items     Item[]
  channel   Channel?  @relation(fields: [channelId], references: [id])

  @@unique([channelId, name])
  @@index([channelId])
  @@map("brands")
}

model Category {
  id        String     @id @default(uuid())
  name      String
  parentId  String?
  channelId String?
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  items     Item[]
  channel   Channel?   @relation(fields: [channelId], references: [id])

  @@unique([channelId, name])
  @@index([channelId])
  @@map("categories")
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  taxPin         String?
  paymentTerms   String?
  channelId      String?
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          Item[]
  purchaseOrders PurchaseOrder[]
  purchases      Purchase[]
  channel        Channel?        @relation(fields: [channelId], references: [id])

  @@unique([channelId, name])
  @@index([channelId])
  @@map("suppliers")
}

model Item {
  id                String             @id @default(uuid())
  enterpriseId      String?
  sku               String             @unique
  barcode           String?
  name              String
  description       String?
  categoryId        String?
  brandId           String?
  supplierId        String?
  unitOfMeasure     String             @default("PCS")
  packSize          Int                @default(1)
  retailPrice       Decimal            @db.Decimal(12, 4)
  wholesalePrice    Decimal            @db.Decimal(12, 4)
  minRetailPrice    Decimal            @db.Decimal(12, 4)
  minWholesalePrice Decimal            @default(0) @db.Decimal(12, 4)
  weightedAvgCost   Decimal            @default(0) @db.Decimal(12, 4)
  reorderLevel      Int                @default(5)
  isSerialized      Boolean            @default(false)
  taxClass          TaxClass           @default(STANDARD)
  imageUrl          String?
  isActive          Boolean            @default(true)
  type              ItemType           @default(PRODUCT)
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  enterprise        Enterprise?        @relation(fields: [enterpriseId], references: [id])
  inventoryBalances InventoryBalance[]
  brand             Brand?             @relation(fields: [brandId], references: [id])
  category          Category?          @relation(fields: [categoryId], references: [id])
  supplier          Supplier?          @relation(fields: [supplierId], references: [id])
  lpoLines          LpoLine[]
  purchaseLines     PurchaseLine[]
  saleItems         SaleItem[]
  serials           Serial[]
  stockMovements    StockMovement[]
  transferLines     TransferLine[]
  stockTakeItems    StockTakeItem[]
  costAudits        CostAudit[]
  invoiceLines      InvoiceLine[]

  @@index([enterpriseId])
  @@index([categoryId])
  @@index([brandId])
  @@index([supplierId])
  @@index([isActive])
  @@map("items")
}

model StockMovement {
  id             String       @id @default(uuid())
  itemId         String
  channelId      String
  movementType   MovementType
  quantityChange Int
  referenceId    String
  referenceType  String
  unitCostAtTime Decimal      @default(0) @db.Decimal(12, 4)
  performedBy    String
  notes          String?
  createdAt      DateTime     @default(now())
  channel        Channel      @relation(fields: [channelId], references: [id])
  item           Item         @relation(fields: [itemId], references: [id])

  @@index([itemId, channelId])
  @@index([createdAt])
  @@index([referenceId, referenceType])
  @@index([channelId, createdAt])
  @@index([movementType])
  @@map("stock_movements")
}

model Serial {
  id        String       @id @default(uuid())
  serialNo  String
  itemId    String
  channelId String
  status    SerialStatus @default(IN_STOCK)
  saleId    String?
  // Which transfer line this unit shipped on, set while status is TRANSFERRED
  // and cleared on receipt/cancellation. Without it, receive() and cancel()
  // could only select serials by (itemId, channelId, status) and so acted on
  // units belonging to a different in-flight transfer of the same item.
  transferLineId String?
  deletedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  channel   Channel      @relation(fields: [channelId], references: [id])
  item      Item         @relation(fields: [itemId], references: [id])
  sale      Sale?        @relation(fields: [saleId], references: [id])
  transferLine TransferLine? @relation(fields: [transferLineId], references: [id])

  @@unique([serialNo, itemId, channelId])
  @@index([itemId])
  @@index([channelId])
  @@index([transferLineId])
  @@map("serials")
}

model Sale {
  id               String           @id @default(uuid())
  receiptNo        String           @unique
  channelId        String
  sessionId        String?
  customerId       String?
  saleType         SaleType         @default(RETAIL)
  totalAmount      Decimal          @db.Decimal(14, 4)
  discountAmount   Decimal          @default(0) @db.Decimal(14, 4)
  taxAmount        Decimal          @default(0) @db.Decimal(14, 4)
  netAmount        Decimal          @db.Decimal(14, 4)
  taxSyncStatus    TaxSyncStatus    @default(NOT_APPLICABLE)
  offlineReceiptNo String?
  notes            String?
  performedBy      String
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deviceDate       DateTime?        @map("device_date")
  dueDate          DateTime?        @db.Timestamptz(6)
  payments         Payment[]
  items            SaleItem[]
  conflicts        SyncConflict[]
  channel          Channel          @relation(fields: [channelId], references: [id])
  customer         Customer?        @relation(fields: [customerId], references: [id])
  session          SalesSession?    @relation(fields: [sessionId], references: [id])
  serials          Serial[]
  commissionEntry  CommissionEntry?
  vatOverride      Boolean          @default(false)
  manualVatAmount  Decimal?         @db.Decimal(14, 4)
  selectedBankId   String?
  bankSnapshot     Json? // Snapshot for PDF rendering

  @@index([channelId, createdAt])
  @@index([customerId])
  @@index([sessionId])
  @@map("sales")
}

model SaleItem {
  id                     String   @id @default(uuid())
  saleId                 String
  itemId                 String
  serialId               String?
  quantity               Int
  unitPrice              Decimal  @db.Decimal(12, 4)
  minRetailPriceSnapshot Decimal  @db.Decimal(12, 4)
  costPriceSnapshot      Decimal  @db.Decimal(12, 4)
  markup                 Decimal  @db.Decimal(12, 4)
  lineTotal              Decimal  @db.Decimal(14, 4)
  discountAmount         Decimal  @default(0) @db.Decimal(14, 4)
  createdAt              DateTime @default(now())
  item                   Item     @relation(fields: [itemId], references: [id])
  sale                   Sale     @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([itemId])
  @@index([createdAt])
  @@index([itemId, createdAt])
  @@index([saleId, costPriceSnapshot])
  @@map("sale_items")
}

model Payment {
  id             String        @id @default(uuid())
  saleId         String
  method         PaymentMethod
  amount         Decimal       @db.Decimal(14, 4)
  reference      String?
  status         PaymentStatus @default(CONFIRMED)
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  sale           Sale          @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@map("payments")
}

model Customer {
  id                   String               @id @default(uuid())
  name                 String
  phone                String?
  email                String?
  tier                 CustomerTier         @default(BRONZE)
  loyaltyPoints        Int                  @default(0)
  creditLimit          Decimal              @default(0) @db.Decimal(14, 4)
  outstandingCredit    Decimal              @default(0) @db.Decimal(14, 4)
  channelId            String?
  deletedAt            DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  kraPin               String?
  contactPerson        String?
  isThirdParty         Boolean              @default(false)
  successfulRepayments Int                  @default(0)
  customerPayments     CustomerPayment[]
  loyaltyTransactions  LoyaltyTransaction[]
  sales                Sale[]
  repairs              RepairRequest[]
  invoices             Invoice[]
  channel              Channel?             @relation(fields: [channelId], references: [id])

  @@unique([channelId, phone])
  @@index([channelId])
  @@map("customers")
}

model LoyaltyTransaction {
  id          String        @id @default(uuid())
  customerId  String
  type        LoyaltyTxType
  points      Int
  referenceId String?
  notes       String?
  createdAt   DateTime      @default(now())
  customer    Customer      @relation(fields: [customerId], references: [id])
  channelId   String
  channel     Channel       @relation(fields: [channelId], references: [id])

  @@index([customerId])
  @@map("loyalty_transactions")
}

model CustomerPayment {
  id         String        @id @default(uuid())
  customerId String
  saleId     String?
  method     PaymentMethod
  amount     Decimal       @db.Decimal(14, 4)
  reference  String?
  notes      String?
  createdAt  DateTime      @default(now())
  customer   Customer      @relation(fields: [customerId], references: [id])
  channelId  String
  channel    Channel       @relation(fields: [channelId], references: [id])

  @@index([customerId])
  @@map("customer_payments")
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNo       String        @unique
  type            InvoiceType   @default(INVOICE)
  status          InvoiceStatus @default(DRAFT)
  channelId       String
  customerId      String
  subtotal        Decimal       @default(0) @db.Decimal(14, 4)
  discountAmount  Decimal       @default(0) @db.Decimal(14, 4)
  taxAmount       Decimal       @default(0) @db.Decimal(14, 4)
  totalAmount     Decimal       @default(0) @db.Decimal(14, 4)
  amountPaid      Decimal       @default(0) @db.Decimal(14, 4)
  dueDate         DateTime?
  notes           String?
  customerOrderNo String?
  quotationRefNo  String?
  taxExempt       Boolean       @default(false)
  terms           String?
  selectedBankId  String?
  convertedFromId String?       @unique
  createdBy       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  voidedAt        DateTime?
  channel         Channel       @relation(fields: [channelId], references: [id])
  customer        Customer      @relation(fields: [customerId], references: [id])
  creator         User          @relation(fields: [createdBy], references: [id])
  bank            ChannelBank?  @relation(fields: [selectedBankId], references: [id])
  convertedFrom   Invoice?      @relation("InvoiceConversion", fields: [convertedFromId], references: [id])
  convertedTo     Invoice?      @relation("InvoiceConversion")
  lines           InvoiceLine[]

  @@index([channelId, createdAt])
  @@index([customerId])
  @@index([status])
  @@index([type])
  @@map("invoices")
}

model InvoiceLine {
  id             String  @id @default(uuid())
  invoiceId      String
  itemId         String?
  description    String
  quantity       Decimal @db.Decimal(12, 4)
  unitPrice      Decimal @db.Decimal(12, 4)
  discountAmount Decimal @default(0) @db.Decimal(14, 4)
  lineTotal      Decimal @db.Decimal(14, 4)
  invoice        Invoice @relation(fields: [invoiceId], references: [id])
  item           Item?   @relation(fields: [itemId], references: [id])

  @@index([invoiceId])
  @@map("invoice_lines")
}

model SalesSession {
  id            String        @id @default(uuid())
  channelId     String
  userId        String
  status        SessionStatus @default(OPEN)
  openingFloat  Decimal       @db.Decimal(14, 4)
  closingFloat  Decimal?      @db.Decimal(14, 4)
  expectedFloat Decimal?      @db.Decimal(14, 4)
  variance      Decimal?      @db.Decimal(14, 4)
  openedAt      DateTime      @default(now())
  closedAt      DateTime?
  notes         String?
  sales         Sale[]
  channel       Channel       @relation(fields: [channelId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@index([channelId])
  @@index([userId])
  @@map("sales_sessions")
}

model PurchaseOrder {
  id           String     @id @default(uuid())
  orderNo      String     @unique
  supplierId   String
  channelId    String
  status       LpoStatus  @default(DRAFT)
  notes        String?
  createdBy    String
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  expectedDate DateTime?
  lines        LpoLine[]
  channel      Channel    @relation(fields: [channelId], references: [id])
  supplier     Supplier   @relation(fields: [supplierId], references: [id])
  purchases    Purchase[]

  @@index([supplierId])
  @@index([channelId])
  @@map("purchase_orders")
}

model LpoLine {
  id              String        @id @default(uuid())
  purchaseOrderId String
  itemId          String
  quantity        Int
  unitCost        Decimal       @db.Decimal(12, 4)
  receivedQty     Int           @default(0)
  status          LpoLineStatus @default(PENDING)
  item            Item          @relation(fields: [itemId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
  @@map("lpo_lines")
}

model Purchase {
  id                String         @id @default(uuid())
  purchaseNo        String         @unique
  supplierId        String
  channelId         String
  purchaseOrderId   String?
  supplierInvoiceNo String?
  purchaseDate      DateTime?
  status            PurchaseStatus @default(DRAFT)
  totalCost         Decimal        @default(0) @db.Decimal(14, 4)
  landedCostTotal   Decimal        @default(0) @db.Decimal(14, 4)
  paymentMethod     PaymentMethod?
  notes             String?
  committedBy       String?
  committedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  landedCosts       LandedCost[]
  lines             PurchaseLine[]
  channel           Channel        @relation(fields: [channelId], references: [id])
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplier          Supplier       @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([channelId])
  @@map("purchases")
}

model PurchaseLine {
  id         String   @id @default(uuid())
  purchaseId String
  itemId     String
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 4)
  lineTotal  Decimal  @db.Decimal(14, 4)
  item       Item     @relation(fields: [itemId], references: [id])
  purchase   Purchase @relation(fields: [purchaseId], references: [id])

  @@index([purchaseId])
  @@map("purchase_lines")
}

model LandedCost {
  id               String                  @id @default(uuid())
  purchaseId       String
  description      String
  amount           Decimal                 @db.Decimal(14, 4)
  allocationMethod ExpenseAllocationMethod @default(BY_VALUE)
  purchase         Purchase                @relation(fields: [purchaseId], references: [id])

  @@index([purchaseId])
  @@map("landed_costs")
}

model Transfer {
  id             String         @id @default(uuid())
  transferNo     String         @unique
  fromChannelId  String
  toChannelId    String
  status         TransferStatus @default(DRAFT)
  sentBy         String?
  receivedBy     String?
  sentAt         DateTime?
  receivedAt     DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lines          TransferLine[]
  sentByUser     User?          @relation("SentTransfers", fields: [sentBy], references: [id])
  receivedByUser User?          @relation("ReceivedTransfers", fields: [receivedBy], references: [id])
  fromChannel    Channel        @relation("FromChannel", fields: [fromChannelId], references: [id])
  toChannel      Channel        @relation("ToChannel", fields: [toChannelId], references: [id])

  @@index([fromChannelId])
  @@index([toChannelId])
  @@map("transfers")
}

model TransferLine {
  id               String   @id @default(uuid())
  transferId       String
  itemId           String
  sentQuantity     Int
  receivedQuantity Int?
  disputeReason    String?
  item             Item     @relation(fields: [itemId], references: [id])
  transfer         Transfer @relation(fields: [transferId], references: [id])
  serials          Serial[]

  @@index([transferId])
  @@map("transfer_lines")
}

model Expense {
  id            String               @id @default(uuid())
  channelId     String
  description   String
  amount        Decimal              @db.Decimal(14, 4)
  category      String?
  receiptRef    String?
  notes         String?
  paymentSource ExpensePaymentSource @default(CASH)
  createdBy     String
  createdAt     DateTime             @default(now())
  deletedAt     DateTime?
  channel       Channel              @relation(fields: [channelId], references: [id])

  @@index([channelId])
  @@index([createdAt])
  @@map("expenses")
}

model ExpenseCategory {
  id        String   @id @default(uuid())
  name      String
  channelId String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  channel   Channel? @relation(fields: [channelId], references: [id])

  @@unique([channelId, name])
  @@index([channelId])
  @@map("expense_categories")
}

model BankDeposit {
  id          String   @id @default(uuid())
  channelId   String
  amount      Decimal  @db.Decimal(14, 4)
  reference   String?
  depositedBy String
  depositedAt DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  channel     Channel  @relation(fields: [channelId], references: [id])

  @@index([channelId])
  @@map("bank_deposits")
}

model StaffProfile {
  id             String          @id @default(uuid())
  userId         String          @unique
  jobTitle       String
  jobLevelId     String?
  grossSalary    Decimal         @db.Decimal(12, 2)
  bankName       String?
  bankAccount    String?
  taxPin         String?
  hireDate       DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  salaryRunLines SalaryRunLine[]
