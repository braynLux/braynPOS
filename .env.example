# ═══════════════════════════════════════════════════════════════════════
# LUX / BRAYN POS — Production Environment Variables Template
# Railway PostgreSQL Native (Zero-Redis Architecture)
# ═══════════════════════════════════════════════════════════════════════

# ── Railway / Native PostgreSQL ──────────────────────────────────────────
# Set automatically by Railway Postgres service plugin (or provided directly):
DATABASE_URL="postgresql://postgres:[PASSWORD]@[RAILWAY_HOST]:5432/railway"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[RAILWAY_HOST]:5432/railway"

# ── Security & Authentication (JWT HS256) ──────────────────────────────
JWT_SECRET="generate_a_secure_64_character_random_secret_for_production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ── Server Configuration ────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
PORT=4000
NODE_ENV=production
LOG_LEVEL=info

# ── Health & Monitoring ─────────────────────────────────────────────────
HEALTH_TOKEN="generate_a_secure_random_token_for_internal_probes"

# ── Cross-Origin Resource Sharing (CORS) ────────────────────────────────
# Set to your production web app domain (or comma-separated URLs)
CORS_ORIGIN="https://your-pos-web.up.railway.app,http://localhost:3000"

# ── Frontend Web App Environment ────────────────────────────────────────
NEXT_PUBLIC_API_URL="https://your-pos-api.up.railway.app"
NEXT_PUBLIC_GEMINI_API_KEY=""

# ── Idempotency & MFA ───────────────────────────────────────────────────
IDEMPOTENCY_TTL_SECONDS=86400
MFA_ISSUER="LUX POS"

# ── Optional Integrations ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-pos-api.up.railway.app/v1/settings/google/callback"
